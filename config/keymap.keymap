#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー番号の定義
#define MAC   0
#define L1    1
#define WIN   2
#define L3    3
#define L4    4
#define L5    5
#define L6    6

/ {
    macros {
        // Mac (BT0) へ切り替え & Macレイヤー(0) へ
        my_sel_mac: my_sel_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 0 &macro_tap &to MAC>;
        };

        my_sel_mac2: my_sel_mac2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 1 &macro_tap &to MAC>;
        };

        // Win (BT2) へ切り替え & Winレイヤー(2) へ
        my_sel_win: my_sel_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 2 &macro_tap &to WIN>;
        };

        my_sel_win2: my_sel_win2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 3 &macro_tap &to WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Mac用ベース
        layer_0 {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp ENTER
                &mt LSHIFT Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &lt 4 MINUS
                &mt LCMD LANG1 &lt 1 SPACE &lt 5 BACKSPACE &mt RSHIFT LANG2
            >;
        };

        // Layer 1
        layer_1 {
            bindings = <
                &kp LPAR &kp RPAR &kp N7 &kp N8 &kp N9 &none &kp LC(TAB) &kp UP_ARROW &kp LS(LC(TAB)) &none
                &kp PLUS &kp MINUS &kp N4 &kp N5 &kp N6 &none &kp LEFT_ARROW &none &kp RIGHT_ARROW &none
                &kp ASTERISK &kp SLASH &kp N1 &kp N2 &kp N3 &none &kp LG(LEFT) &kp DOWN_ARROW &kp LG(RIGHT) &none
                &kp EQUAL &kp N0 &kp DEL &none
            >;
        };

        // Layer 2: Windows用ベース
        layer_2 {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp ENTER
                &mt LSHIFT Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &lt 4 MINUS
                &mt LCTRL LANG1 &lt 3 SPACE &lt 5 BACKSPACE &mt RSHIFT LANG2
            >;
        };

        // Layer 3
        layer_3 {
            bindings = <
                &kp LPAR &kp RPAR &kp N7 &kp N8 &kp N9 &kp QMARK &kp EXCL &none &none &none
                &kp PLUS &kp MINUS &kp N4 &kp N5 &kp N6 &none &none &none &none &none
                &kp ASTERISK &kp SLASH &kp N1 &kp N2 &kp N3 &none &none &kp LA(LEFT) &kp LA(RIGHT) &none
                &kp EQUAL &kp N0 &kp DEL &none
            >;
        };

        // Layer 4: 設定 (BT切り替え+スクロールレイヤー)
        layer_4 {
            bindings = <
                &none &none &none &none &none &my_sel_mac &my_sel_mac2 &my_sel_win &my_sel_win2 &bt BT_SEL 4
                &none &none &none &none &none &bt BT_CLR &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none
            >;
        };

        // Layer 5
        layer_5 {
            bindings = <
                &kp LPAR &kp RPAR &kp N7 &kp N8 &kp N9 &kp QMARK &kp EXCL &none &none &none
                &kp PLUS &kp MINUS &kp N4 &kp N5 &kp N6 &none &none &none &none &none
                &kp ASTERISK &kp SLASH &kp N1 &kp N2 &kp N3 &none &none &none &none &none
                &kp EQUAL &kp N0 &none &none
            >;
        };

        // Layer 6
        layer_6 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &mkp LCLK &mkp RCLK &trans
                &trans &trans &trans &trans
            >;
        };
    };
};
