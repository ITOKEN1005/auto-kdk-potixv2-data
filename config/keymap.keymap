#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー番号の定義
#define MAC   0
#define L1    1
#define L2    2
#define L3    3
#define WIN   4
#define L5    5

/ {
    macros {
        // Mac (BT0) へ切り替え & Macレイヤー(0) へ
        // 修正点: 全てのコマンドを1つの < > 内に記述します
        my_sel_mac: my_sel_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 0 &macro_tap &to MAC>;
        };

        // Win (BT1) へ切り替え & Winレイヤー(4) へ
        my_sel_win: my_sel_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 1 &macro_tap &to WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Mac用ベース
        layer_0 {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp ENTER
                &mt LSHIFT Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &lt 3 MINUS
                &mt LCTRL LANG1 &lt 2 SPACE &lt 1 BACKSPACE &lt 5 LANG2
            >;
        };

        // Layer 1
        layer_1 {
            bindings = <
                &kp LPAR &kp RPAR &kp N7 &kp N8 &kp N9 &kp QMARK &kp EXCL &none &none &none
                &kp PLUS &kp MINUS &kp N4 &kp N5 &kp N6 &none &none &none &none &none
                &kp ASTERISK &kp SLASH &kp N1 &kp N2 &kp N3 &none &none &none &none &none
                &kp EQUAL &kp N0 &none &none
            >;
        };

        // Layer 2
        layer_2 {
            bindings = <
                &kp ESCAPE &none &none &none &none &none &none &kp UP_ARROW &none &none
                &kp LA(TAB) &none &none &none &none &none &kp LEFT_ARROW &none &kp RIGHT_ARROW &none
                &none &none &none &none &none &none &none &kp DOWN_ARROW &none &none
                &none &none &none &none
            >;
        };

        // Layer 3: 設定 (BT切り替え)
        layer_3 {
            bindings = <
                &none &none &none &none &none &my_sel_mac &my_sel_win &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none &none &none &none &none &bt BT_CLR &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none
            >;
        };

        // Layer 4: Windows用ベース
        layer_4 {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp ENTER
                &mt LSHIFT Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &lt 3 MINUS
                &mt LCTRL INT_MUHENKAN &lt 2 SPACE &lt 1 BACKSPACE &lt 5 INT_HENKAN
            >;
        };

        // Layer 5
        layer_5 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &kp LG(LEFT) &kp LG(RIGHT) &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &mkp LCLK &mkp RCLK &trans
                &trans &trans &trans &trans
            >;
        };
    };
};
