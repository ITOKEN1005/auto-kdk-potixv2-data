#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー名の定義
#define L0  0 //Mac用ベースレイヤー
#define L1  1
#define L2  2 //Windows用ベースレイヤー
#define L3  3
#define L4  4 //テンキーレイヤー
#define L5  5 //記号レイヤー
#define L6  6 //マウスレイヤー
/ {
    macros {
        // BT 0番を選択し、Macレイヤーへ切り替え
        sel_mac: sel_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to L0>;
        };


        // BT 1番を選択し、Macレイヤーへ切り替え
        sel_mac: sel_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to L0>;
        };

       
        // BT 2番を選択し、Windowsレイヤーへ切り替え
        sel_win: sel_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Macベース
        layer_0 {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp ENTER
                &mt LSHIFT Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &lt L3 MINUS
                &mt LCMD LANG1 &lt L2 SPACE &lt L1 BACKSPACE &lt L5 LANG2
            >;
        };

        layer_1 {
            bindings = <
                &kp LPAR &kp RPAR &kp N7 &kp N8 &kp N9 &kp QMARK &kp EXCL &none &none &none
                &kp PLUS &kp MINUS &kp N4 &kp N5 &kp N6 &none &none &none &none &none
                &kp ASTERISK &kp SLASH &kp N1 &kp N2 &kp N3 &none &none &none &none &none
                &kp EQUAL &kp N0 &none &none
            >;
        };

        layer_2 {
            bindings = <
                &kp ESCAPE &none &none &none &none &none &none &kp UP_ARROW &none &none
                &kp LA(TAB) &none &none &none &none &none &kp LEFT_ARROW &none &kp RIGHT_ARROW &none
                &none &none &none &none &none &none &none &kp DOWN_ARROW &none &none
                &none &none &none &none
            >;
        };

        // Layer 3: 設定・BT切り替え
        layer_3 {
            bindings = <
                &none &none &none &none &none &sel_mac &sel_win &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none &none &none &none &none &bt BT_CLR &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none
            >;
        };

        // Layer 4: Windowsベース (Mac用のLCMDをLWIN/LCTRLに変更)
        layer_4 {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp ENTER
                &mt LSHIFT Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &lt L3 MINUS
                &mt LCTRL MHEN &lt L2 SPACE &lt L1 BACKSPACE &lt L5 HENK
            >;
        };

        layer_5 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &kp LG(LEFT) &kp LG(RIGHT) &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &mkp LCLK &mkp RCLK &trans
                &trans &trans &trans &trans
            >;
        };
    };
};
